<?xml version="1.0" encoding="utf-8"?>
<!--
  Config NuGet locale au dépôt NEXUS.
  Le fichier NuGet.Config global de la machine restreint nuget.org via packageSourceMapping ;
  cette section est redéfinie ici (le fichier le plus proche l'emporte) pour autoriser tous
  les packages depuis nuget.org, sans modifier la configuration machine partagée avec d'autres projets.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
