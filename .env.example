# NEXUS — variables d'environnement (copier vers .env, jamais commiter .env)
# Article 45/72/75 : aucun secret réel dans Git.

# --- PostgreSQL ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_pwd
POSTGRES_DB=nexus

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_dev_pwd

# --- Backend (ASP.NET Core) ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=nexus;Username=nexus;Password=nexus_dev_pwd
Nexus__Neo4j__Uri=bolt://localhost:7687
Nexus__Neo4j__User=neo4j
Nexus__Neo4j__Password=nexus_dev_pwd
Nexus__Storage__BlobConnectionString=UseDevelopmentStorage=true

# --- Azure OpenAI (laisser vide en local ; renseigné via Key Vault en cloud) ---
Nexus__AI__Endpoint=
Nexus__AI__ApiKey=
Nexus__AI__ChatDeployment=gpt-4o
Nexus__AI__EmbeddingDeployment=text-embedding-3-large

# --- Auth (Microsoft Entra ID — vide en local, stub dev) ---
Nexus__Auth__Authority=
Nexus__Auth__Audience=
