# NEXUS — normalisation des fins de ligne
* text=auto

# Fichiers texte forcés en LF (cohérence multi-OS)
*.cs      text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.sln     text eol=crlf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.cypher  text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf

# Binaires
*.png binary
*.jpg binary
*.pdf binary
*.pfx binary
